# for dt ablation
for d in $D_VALUES
do
    for T in $T_VALUES
    do
        for DT in $DT_VALUES
        do
            for X0 in $X0_inits
            do
                for NUM_TRAJ in $NUM_TRAJECTORIES_VALUES
                do
                    echo "Running experiment for d=$d, T=$T, dt=$DT, num_trajectories=$NUM_TRAJ, fixed_X0=$X0, methods=OT 'OT reg'"
                    python main.py \
                        --master_seed=60\
                        --d=$d \
                        --simulation_mode='killed' \
                        --dt_em=0.001 \
                        --n_sdes=1 \
                        --fixed_X0=$X0 \
                        --drift_initialization='negative_eigenvalue' \
                        --diffusion_initialization='scaled_identity' \
                        --D=1 \
                        --dt=$DT \
                        --num_trajectories=$NUM_TRAJ \
                        --T=$T \
                        --n_iterations=1 \
                        --true_A=False \
                        --true_G=False \
                        --saved_drifts_diffusions_file='2D_ex_rotation' \
                        --ablation_variable_name='n_iterations' \
                        --ablation_values='100' \
                        --methods 'OT reg' \
                        --display_plot=True \
                        --save_results=True
                    echo "Experiment done for d=$d, T=$T, dt=$DT, num_trajectories=$NUM_TRAJ, fixed_X0=$X0, methods=OT 'OT reg'"
                done
            done
        done
    done
done
